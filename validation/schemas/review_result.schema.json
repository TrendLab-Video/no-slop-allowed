{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sneldao/recliner/schemas/review_result.schema.json",
  "title": "Recliner validation review result",
  "type": "object",
  "required": [
    "job_id",
    "reviewer",
    "status",
    "scores",
    "findings"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "hook": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "visual_craft": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "originality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "brief_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reference_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diversity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "emotional_payoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "standard_id",
          "finding",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "standard_id": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "repairable": {
            "type": "boolean"
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "model_output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
