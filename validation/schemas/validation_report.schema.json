{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sneldao/recliner/schemas/validation_report.schema.json",
  "title": "Recliner validation report",
  "type": "object",
  "required": [
    "artifact_type",
    "version",
    "created_at",
    "source_brief",
    "target_video",
    "status",
    "hard_gates",
    "scores",
    "findings",
    "summary",
    "agentic_review_status",
    "cost"
  ],
  "properties": {
    "artifact_type": {
      "const": "validation_report"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "source_brief": {
      "type": "string"
    },
    "target_video": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "repair_required",
        "fail"
      ]
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "actual": true,
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "hook",
        "clarity",
        "visual_craft",
        "originality",
        "brief_fit",
        "reference_alignment",
        "diversity",
        "emotional_payoff"
      ],
      "properties": {
        "hook": {
          "type": "number"
        },
        "clarity": {
          "type": "number"
        },
        "visual_craft": {
          "type": "number"
        },
        "originality": {
          "type": "number"
        },
        "brief_fit": {
          "type": "number"
        },
        "reference_alignment": {
          "type": "number"
        },
        "diversity": {
          "type": "number"
        },
        "emotional_payoff": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "type": "string"
    },
    "agentic_review_status": {
      "enum": [
        "completed",
        "degraded",
        "not_run"
      ]
    },
    "cost": {
      "type": "object",
      "required": [
        "band_plan",
        "model_input_tokens",
        "model_output_tokens",
        "estimated_model_cost_usd",
        "tavily_credits",
        "wall_time_ms"
      ],
      "properties": {
        "band_plan": {
          "enum": [
            "free",
            "pro",
            "enterprise",
            "not_used"
          ]
        },
        "model_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_model_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tavily_credits": {
          "type": "number",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object"
    },
    "probes": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "standard_id",
        "reviewer",
        "finding",
        "evidence",
        "recommendation",
        "repairable"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        },
        "standard_id": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "finding": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "repairable": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
